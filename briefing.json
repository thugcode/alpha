   "sections": [
    {
     "id": "news",
     "title": "군무원 소식",
     "short": "군무원 소식",
     "items": [
      {
       "tag": "국방부",
       "t": "국회 국방위, 2027년도 국방부 예산안 심사 시작",
       "s": "국회 국방위원회가 11월 9일 전체회의를 열어 2027년도 국방부·병무청 예산안 심사에 들어갔다. 군무원 인건비와 처우 관련 예산이 어떻게 조정되는지는 앞으로 이어질 심사에서 정해진다.",
       "src": "글로벌뉴스통신",
       "url": "https://www.globalnewsagency.kr/news/articleView.html?idxno=503784",
       "date": "11.09"
      },
      {
       "tag": "국방부",
       "t": "군무원인사법 시행령 개정안, 의견 접수 마감",
       "s": "국방부가 9월 30일 입법예고한 군무원인사법 시행령 일부개정령안의 의견 접수가 11월 9일로 끝났다. 바뀌는 조문은 국민참여입법센터 공고에서 확인할 수 있다.",
       "src": "국민참여입법센터",
       "url": "https://community.lawmaking.go.kr/gcom/ogLmPp/88840?opnOpYn=Y",
       "date": "11.09"
      },
      {
       "tag": "국방부",
       "t": "군무원은 5년 동안 주택수당 한 푼도 못 받아",
       "s": "국정감사 자료를 보면 2021~2025년 군인에게 주택수당 2,526억 원이 지급됐지만 군무원은 지급 대상이 아니어서 받은 돈이 없었다. 군 숙소도 장기 공실이 예상될 때처럼 제한된 경우에만 쓸 수 있다는 지적이 함께 나왔다.",
       "src": "뷰어스",
       "url": "https://feed.viewus.co.kr/ai/article/332824/",
       "date": "10.11"
      },
      {
       "tag": "전 군",
       "t": "내년 공무원 보수 3.9% 인상안, 저연차는 더 오른다",
       "s": "정부 예산안에 2027년 공무원 보수를 3.9% 올리는 안이 들어갔고, 16년 만에 가장 큰 폭이다. 7~9급은 공통 인상분에 추가 인상률이 더해진다.",
       "src": "한국경제",
       "url": "https://www.hankyung.com/article/202609017426v",
       "date": "09.01"
      },
      {
       "tag": "전 군",
       "t": "군무원 두발 길이 제한 내부 지침 없앤다",
       "s": "현역 기준을 군무원에게도 적용하던 국방부 내부 두발 지침이 폐지되기로 했다. 군무원 단체는 환영하면서도 당직·부대훈련 같은 업무 부담은 여전하다고 지적했다.",
       "src": "네이트 뉴스",
       "url": "https://m.news.nate.com/view/20260903n32139",
       "date": "09.03"
      },
      {
       "tag": "국방부",
       "t": "군무원복지기본법 제정안 국회 발의",
       "s": "군무원에게 숙소를 제공하고 임대 자금을 지원하는 근거를 담은 법안이 대표발의됐다. 함께 공개된 국방부 자료에서 군무원 숙소 입주율은 18.2%에 머물렀다.",
       "src": "네이트 뉴스",
       "url": "https://m.news.nate.com/view/20260811n00123",
       "date": "08.11"
      }
     ]
    },
    {
     "id": "benefit",
     "title": "복지·혜택",
     "short": "혜택",
     "items": [
      {
       "tag": "전 군",
       "t": "국방복지포털에서 렌터카·카셰어링 할인 제공",
       "s": "국방복지포털 제휴 혜택에 군인과 군무원을 대상으로 한 롯데렌터카 G car, 쏘카 할인이 올라 있다. 이용할 때는 보통 밀리패스 앱이나 공무원증으로 신분을 확인한다.",
       "src": "국방복지포털",
       "url": "https://www.imnd.or.kr/user/comm/co_2.go?menuId=70300",
       "date": "상시"
      },
      {
       "tag": "전 군",
       "t": "이스타항공 군무원·가족 항공권 10% 할인",
       "s": "군무원 본인과 직계가족이 받을 수 있는 혜택이다. 국내선은 정상운임, 국제선은 할인운임 기준으로 10%를 깎아 주며 연중 적용된다.",
       "src": "전자신문",
       "url": "https://www.etnews.com/20260403000251",
       "date": "연중"
      },
      {
       "t": "공무원 난임 휴직 12월부터 별도 휴직으로 시행",
       "s": "국가·지방공무원법 개정으로 난임 치료를 이유로 한 휴직이 독립된 휴직 사유로 생겼고 12월부터 적용된다. 국가공무원 기준 제도이므로 군무원 적용 여부와 세부 요건은 소속 부대 인사 담당 부서에 확인해야 한다.",
       "src": "디지털타임스",
       "url": "https://www.dt.co.kr/article/12064284",
       "date": "12월 시행"
      },
      {
       "t": "2026년 정액급식비 월 16만 원으로 인상",
       "s": "2020년 이후 동결됐던 국가공무원 정액급식비가 월 14만 원에서 16만 원으로 올랐다. 국가공무원 규정 기준이라 군무원 적용 금액은 소속 인사 담당에게 확인한다.",
       "src": "인사혁신처",
       "url": "https://www.mpm.go.kr/mpm/comm/newsPress/newsPressRelease/?boardId=bbs_0000000000000029&mode=view&cntId=4187&category=&pageIdx=",
       "date": "2026년"
      }
